{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MatrixClaw Desktop Shell",
  "version": "0.1.0",
  "identifier": "ai.matrixclaw.desktop-shell",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "MatrixClaw",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
